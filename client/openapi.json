{
  "openapi": "3.1.0",
  "info": {
    "title": "Adunata",
    "description": "",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/catalogs/{locale}": {
      "get": {
        "operationId": "catalog",
        "parameters": [
          {
            "name": "locale",
            "in": "path",
            "description": "Language of the catalog, such as de or en",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fluent catalog",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No catalog for this language"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Ready to serve requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/legal-links": {
      "get": {
        "operationId": "legal_links",
        "responses": {
          "200": {
            "description": "Links every page shows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalLinks"
                }
              }
            }
          }
        }
      }
    },
    "/api/members": {
      "get": {
        "operationId": "list_members",
        "responses": {
          "200": {
            "description": "Every member, sorted by last name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Member"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "add_member",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewMember"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Member added as active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "422": {
            "description": "Member invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{id}": {
      "put": {
        "operationId": "change_member",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the member",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Member changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "404": {
            "description": "No such member"
          },
          "422": {
            "description": "Change invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    },
    "/api/spike-responses": {
      "post": {
        "operationId": "create_response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpikeResponse"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Response stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpikeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Response invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attendance": {
        "type": "string",
        "enum": [
          "accepted",
          "tentative",
          "declined"
        ]
      },
      "Cause": {
        "type": "string",
        "enum": [
          "database"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "description": "Why a field was rejected. The client turns each code into a message from the catalog.",
        "enum": [
          "required",
          "tooLong",
          "tooLarge",
          "taken",
          "invalid"
        ]
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "code"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "conflict": {
            "type": [
              "string",
              "null"
            ],
            "description": "The stored value that a taken value collides with, such as a mail address that differs only in case."
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Whether the instance can serve requests. It holds no personal data and no configuration values.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "cause": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Cause"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "LegalLinks": {
        "type": "object",
        "description": "Addresses of the privacy notice and the imprint that every page links. A missing address means the operator set none.",
        "properties": {
          "privacyUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "imprintUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Member": {
        "type": "object",
        "description": "A person in the ensemble whom organizers can invite.",
        "required": [
          "id",
          "firstName",
          "lastName",
          "mail",
          "language",
          "active",
          "organizer"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "mail": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "Language of the member's mail, `de` or `en`."
          },
          "active": {
            "type": "boolean"
          },
          "organizer": {
            "type": "boolean"
          }
        }
      },
      "MemberChange": {
        "type": "object",
        "description": "Every field of a member that an organizer can change.",
        "required": [
          "firstName",
          "lastName",
          "mail",
          "language",
          "active",
          "organizer"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "mail": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "organizer": {
            "type": "boolean"
          }
        }
      },
      "NewMember": {
        "type": "object",
        "description": "What an organizer enters for a new member. A new member is active and holds no role.",
        "required": [
          "firstName",
          "lastName",
          "mail",
          "language"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "mail": {
            "type": "string"
          },
          "language": {
            "type": "string"
          }
        }
      },
      "SpikeResponse": {
        "type": "object",
        "required": [
          "name",
          "attendance",
          "beds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "attendance": {
            "$ref": "#/components/schemas/Attendance"
          },
          "arrival": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "beds": {
            "type": "integer",
            "format": "int32",
            "maximum": 20,
            "minimum": 0
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": [
          "ready",
          "unavailable"
        ]
      },
      "ValidationErrors": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      }
    }
  }
}
