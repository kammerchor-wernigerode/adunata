{
  "openapi": "3.1.0",
  "info": {
    "title": "Adunata",
    "description": "",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/spike-responses": {
      "post": {
        "operationId": "create_response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpikeResponse"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Response stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpikeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attendance": {
        "type": "string",
        "enum": [
          "accepted",
          "tentative",
          "declined"
        ]
      },
      "SpikeResponse": {
        "type": "object",
        "required": [
          "name",
          "attendance",
          "beds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "attendance": {
            "$ref": "#/components/schemas/Attendance"
          },
          "arrival": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "beds": {
            "type": "integer",
            "format": "int32",
            "maximum": 20,
            "minimum": 0
          }
        }
      }
    }
  }
}
