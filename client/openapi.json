{
  "openapi": "3.1.0",
  "info": {
    "title": "Adunata",
    "description": "",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/catalogs/{locale}": {
      "get": {
        "operationId": "catalog",
        "parameters": [
          {
            "name": "locale",
            "in": "path",
            "description": "Language of the catalog, such as de or en",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fluent catalog",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No catalog for this language"
          }
        }
      }
    },
    "/api/gatherings": {
      "get": {
        "operationId": "list_gatherings",
        "responses": {
          "200": {
            "description": "Upcoming and past gatherings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatheringList"
                }
              }
            }
          },
          "401": {
            "description": "No valid organizer session"
          }
        }
      },
      "post": {
        "operationId": "create_gathering",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GatheringInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Gathering created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gathering"
                }
              }
            }
          },
          "401": {
            "description": "No valid organizer session"
          },
          "422": {
            "description": "Gathering invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    },
    "/api/gatherings/{id}": {
      "get": {
        "operationId": "get_gathering",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the gathering",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The gathering",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gathering"
                }
              }
            }
          },
          "401": {
            "description": "No valid organizer session"
          },
          "404": {
            "description": "No such gathering"
          }
        }
      },
      "put": {
        "operationId": "change_gathering",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the gathering",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GatheringInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Gathering changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gathering"
                }
              }
            }
          },
          "401": {
            "description": "No valid organizer session"
          },
          "404": {
            "description": "No such gathering"
          },
          "422": {
            "description": "Change invalid or the gathering has ended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    },
    "/api/gatherings/{id}/invitations": {
      "post": {
        "operationId": "invite",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the gathering",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Members invited and their mail queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invited"
                }
              }
            }
          },
          "401": {
            "description": "No valid organizer session"
          },
          "404": {
            "description": "No such gathering"
          },
          "422": {
            "description": "The gathering is cancelled or has ended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Ready to serve requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/legal-links": {
      "get": {
        "operationId": "legal_links",
        "responses": {
          "200": {
            "description": "Links every page shows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalLinks"
                }
              }
            }
          }
        }
      }
    },
    "/api/members": {
      "get": {
        "operationId": "list_members",
        "responses": {
          "200": {
            "description": "Every member, sorted by last name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Member"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid organizer session"
          }
        }
      },
      "post": {
        "operationId": "add_member",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewMember"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Member added as active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "401": {
            "description": "No valid organizer session"
          },
          "422": {
            "description": "Member invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{id}": {
      "put": {
        "operationId": "change_member",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the member",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Member changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "401": {
            "description": "No valid organizer session"
          },
          "404": {
            "description": "No such member"
          },
          "422": {
            "description": "Change invalid or it would leave no active organizer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_member",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the member",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Member deleted together with everything that belongs to the member"
          },
          "401": {
            "description": "No valid organizer session"
          },
          "404": {
            "description": "No such member"
          },
          "422": {
            "description": "The member is the last active organizer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "operationId": "current_session",
        "responses": {
          "200": {
            "description": "The signed-in organizer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          }
        }
      },
      "delete": {
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Session ended and its cookie removed"
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "summary": "Expects the secret of a sign-in link as `Authorization: Bearer <secret>`.",
        "operationId": "sign_in",
        "responses": {
          "201": {
            "description": "Session started, its cookie is set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "401": {
            "description": "The link is unknown, used or expired"
          }
        }
      }
    },
    "/api/sign-in-requests": {
      "post": {
        "operationId": "request_sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Same answer whether or not the address belongs to an organizer"
          }
        }
      }
    },
    "/api/spike-responses": {
      "post": {
        "operationId": "create_response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpikeResponse"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Response stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpikeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Response invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attendance": {
        "type": "string",
        "enum": [
          "accepted",
          "tentative",
          "declined"
        ]
      },
      "Cause": {
        "type": "string",
        "enum": [
          "database"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "description": "Why a field was rejected. The client turns each code into a message from the catalog.",
        "enum": [
          "required",
          "tooLong",
          "tooLarge",
          "taken",
          "invalid",
          "lastOrganizer",
          "beforeFirstDay",
          "ended",
          "cancelled"
        ]
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "code"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "conflict": {
            "type": [
              "string",
              "null"
            ],
            "description": "The stored value that a taken value collides with, such as a mail address that differs only in case."
          }
        }
      },
      "Gathering": {
        "type": "object",
        "description": "A span of days on which the ensemble meets, as organizers see it.",
        "required": [
          "id",
          "title",
          "location",
          "firstDay",
          "lastDay",
          "cancelled",
          "ended"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "firstDay": {
            "type": "string",
            "format": "date"
          },
          "lastDay": {
            "type": "string",
            "format": "date"
          },
          "cancelled": {
            "type": "boolean"
          },
          "ended": {
            "type": "boolean",
            "description": "Whether the last day has passed in the time zone of the instance."
          }
        }
      },
      "GatheringInput": {
        "type": "object",
        "description": "What an organizer enters for a gathering.",
        "required": [
          "title",
          "location",
          "firstDay",
          "lastDay"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "firstDay": {
            "type": "string",
            "format": "date"
          },
          "lastDay": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "GatheringList": {
        "type": "object",
        "description": "Gatherings split at the present. Upcoming ones come first, ordered by first day. Past ones follow with the latest first.",
        "required": [
          "upcoming",
          "past"
        ],
        "properties": {
          "upcoming": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Gathering"
            }
          },
          "past": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Gathering"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Whether the instance can serve requests. It holds no personal data and no configuration values.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "cause": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Cause"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "InvitationRequest": {
        "type": "object",
        "description": "Which members to invite. Without ids Adunata invites every active member who is not invited yet.",
        "properties": {
          "memberIds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "Invited": {
        "type": "object",
        "description": "How many members Adunata invited.",
        "required": [
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "LegalLinks": {
        "type": "object",
        "description": "Addresses of the privacy notice and the imprint that every page links. A missing address means the operator set none.",
        "properties": {
          "privacyUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "imprintUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Member": {
        "type": "object",
        "description": "A person in the ensemble whom organizers can invite.",
        "required": [
          "id",
          "firstName",
          "lastName",
          "mail",
          "language",
          "active",
          "organizer"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "mail": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "Language of the member's mail, `de` or `en`."
          },
          "active": {
            "type": "boolean"
          },
          "organizer": {
            "type": "boolean"
          }
        }
      },
      "MemberChange": {
        "type": "object",
        "description": "Every field of a member that an organizer can change.",
        "required": [
          "firstName",
          "lastName",
          "mail",
          "language",
          "active",
          "organizer"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "mail": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "organizer": {
            "type": "boolean"
          }
        }
      },
      "NewMember": {
        "type": "object",
        "description": "What an organizer enters for a new member. A new member is active and holds no role.",
        "required": [
          "firstName",
          "lastName",
          "mail",
          "language"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "mail": {
            "type": "string"
          },
          "language": {
            "type": "string"
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "description": "The mail address for which someone asks for a sign-in link.",
        "required": [
          "mail"
        ],
        "properties": {
          "mail": {
            "type": "string"
          }
        }
      },
      "SpikeResponse": {
        "type": "object",
        "required": [
          "name",
          "attendance",
          "beds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "attendance": {
            "$ref": "#/components/schemas/Attendance"
          },
          "arrival": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "beds": {
            "type": "integer",
            "format": "int32",
            "maximum": 20,
            "minimum": 0
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": [
          "ready",
          "unavailable"
        ]
      },
      "ValidationErrors": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      }
    }
  }
}
