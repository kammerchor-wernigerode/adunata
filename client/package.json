{
  "name": "adunata-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run --exclude '**/*.integration.test.*'",
    "test:integration": "vitest run integration.test",
    "generate": "orval",
    "e2e": "playwright test",
    "lint:editorconfig": "cd .. && EC_VERSION=v3.6.1 editorconfig-checker",
    "lint:licenses": "pnpm licenses list --json > node_modules/.licenses.json && pnpm licenses list --json --prod > node_modules/.licenses-prod.json && node scripts/check-licenses.mjs node_modules/.licenses.json node_modules/.licenses-prod.json",
    "check:generated": "sh scripts/check-generated.sh"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "editorconfig-checker": "^7.0.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "orval": "^8.47.0",
    "oxc-transform-react": "^0.158.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
