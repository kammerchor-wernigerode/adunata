root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{LICENSE,.agents/skills/openspec-*/**,client/src/api/generated/**,client/licenses/**,nix/licenses/**}]
indent_style = unset
indent_size = unset

[*.py]
indent_size = 4
